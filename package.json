{
  "name": "react-doc-template-editor",
  "version": "0.1.0",
  "description": "A React component library for building drag-and-drop document template editors (invoices, estimates, quotes)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@dnd-kit/core": ">=6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "react",
    "document",
    "template",
    "editor",
    "invoice",
    "estimate",
    "quote",
    "drag-and-drop",
    "canvas",
    "widget",
    "pdf"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Handiers/react-doc-template-editor"
  },
  "author": "Handiers",
  "sideEffects": [
    "*.css"
  ]
}
